# Required. Server-side only — never expose this to the browser.
# Get one from https://reactor.inc
REACTOR_API_KEY=rk_your_key_here

# Optional. With this set, Claude writes a cutaway shot for the actual headline
# instead of using the built-in footage library. Nothing breaks without it.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Hard cap on a single Reactor session, in seconds (default 3600).
# This is the blast radius of a session that escapes clean teardown.
# REACTOR_MAX_SESSION_SECONDS=3600

# Optional. Planned session rotation interval, in minutes (default 50).
# NEXT_PUBLIC_ROTATE_MINUTES=50
