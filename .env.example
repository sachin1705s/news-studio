# Required. Server-side only — exchanged for a short-lived scoped JWT.
# Create one from API Keys in the Reactor dashboard: https://reactor.inc
REACTOR_API_KEY=rk_your_key_here

# Required. The newsroom: story treatments, anchor copy, shot lists,
# correspondents, and the anchor's replies to viewers.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Recommended. Redis for comments, presence, the channel registry and the
# broadcast history. Without it these fall back to per-instance memory and are
# forgotten on a cold start. Vercel: `vercel integration add upstash/upstash-kv`
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Unlocks the operator panel at ?ops=<secret> — live credit balance,
# burn rate as a multiple of one session, and a stop button.
OPS_SECRET=

# Optional. Set to 1 to refuse every origin token: a kill switch that no open
# tab can work around.
CHANNEL_OFF=

# Optional. Hard ceiling on a single session, in seconds. Default 3600.
# This is the blast radius of a session that escapes clean teardown.
REACTOR_MAX_SESSION_SECONDS=
